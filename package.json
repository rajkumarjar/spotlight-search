{
  "name": "spotlight-search",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:installer": "tauri build --bundles nsis",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write index.html package.json src tailwind.config.cjs postcss.config.cjs eslint.config.js .prettierrc.json README.md CONTRIBUTING.md SECURITY.md .github/workflows/ci.yml",
    "format:check": "prettier --check index.html package.json src tailwind.config.cjs postcss.config.cjs eslint.config.js .prettierrc.json README.md CONTRIBUTING.md SECURITY.md .github/workflows/ci.yml"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@tauri-apps/api": "^2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.3.5"
  }
}
